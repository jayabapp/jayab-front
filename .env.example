# Copy to .env.local. Values are per environment; NEXT_PUBLIC_* ships to every browser.
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_WEB_SITE=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_WEBSITE_URL=
NEXT_PUBLIC_TITLE=
NEXT_PUBLIC_PAYMENT_GATEWAY=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_ENAMAD_ID=
NEXT_PUBLIC_ENAMAD_CODE=
NEXT_PUBLIC_METRIX_APP_ID=
NEXT_PUBLIC_METRIX_APP_KEY=

# Theme engine (docs/dark-light-i18n/02). Build-time: changing it needs a rebuild.
# Anything but 1 keeps the app light and ignores the jayab_theme cookie and the OS setting.
NEXT_PUBLIC_THEME_ENABLED=

# UI languages (docs/dark-light-i18n/03). Build-time: changing it needs a rebuild.
# Comma list of fa,ar,en; fa is always on. Unset or `fa` = Persian only, and the
# jayab_locale cookie is ignored. More than one language makes the root layout read
# cookies, i.e. dynamic rendering: compare the build output before enabling.
NEXT_PUBLIC_ENABLED_LOCALES=

# Header display controls (docs/dark-light-i18n/05). Build-time. Set to 1 to show the
# theme/language picker in the header; it only lists what is enabled above (theme needs
# NEXT_PUBLIC_THEME_ENABLED=1, language needs more than one entry in NEXT_PUBLIC_ENABLED_LOCALES).
# Unset hides the picker without turning either engine off.
NEXT_PUBLIC_DISPLAY_CONTROLS_ENABLED=

# Neshan map. The web key only loads tiles; the service key (search + reverse
# geocode) is server-only and used by app/api/map/*.
NEXT_PUBLIC_NESHAN_MAP_KEY=
NESHAN_SERVICE_KEY=

# Login-page gate for the QA domain (proxy.ts / helpers/basicAuthGate.ts):
# an unauthenticated visitor is redirected to /qa-login instead of getting a
# browser Basic Auth prompt. Server-only — never NEXT_PUBLIC_*. Leave
# BASIC_AUTH_USER or BASIC_AUTH_PASSWORD empty to turn the gate off without
# a rebuild. BASIC_AUTH_HOSTS defaults to jayab.org,www.jayab.org when unset.
BASIC_AUTH_HOSTS=
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Server-only flags
SANDBOX_MODE=
